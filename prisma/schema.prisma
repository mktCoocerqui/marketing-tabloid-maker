// Modelo de dados — Plataforma de tabloides
// Proposta Fase 0. Ver docs/MODELO-DE-DADOS.md e docs/ARQUITETURA.md.
// Princípio central: dados comerciais (Product/Offer) são separados da apresentação
// (Template/Tabloid/OfferFrame). Um offer-frame referencia a oferta por id, nunca a copia.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Em produção (Vercel), url aponta para a conexão POOLED (PgBouncer/Neon/Supabase);
  // directUrl é a conexão direta usada pelas migrations. Em dev, ambas podem ser iguais.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────── Usuários & acesso ─────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      UserRole @default(EDITOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdProducts  Product[]
  createdTabloids  Tabloid[]      @relation("TabloidOwner")
  reviewParticipations ReviewParticipant[]
}

enum UserRole {
  ADMIN
  EDITOR
  REVIEWER
}

// ───────────────────────────── PIM: Produtos ─────────────────────────────────

model Product {
  id            String   @id @default(cuid())
  name          String
  description   String?
  shortDesc     String?
  category      String?
  subcategory   String?
  internalCode  String?  @unique
  barcode       String?
  unit          String?  // un, kg, cx, L...
  metadata      Json?    // campos adicionais flexíveis
  mainImageUrl  String?
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  images        ProductImage[]
  offers        Offer[]

  @@index([category])
  @@index([name])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)
}

// ───────────────────────────── Ofertas & dinâmicas ───────────────────────────

// Catálogo de dinâmicas comerciais (registry no código; tabela p/ metadados/UI).
model OfferType {
  id          String  @id            // "simple", "de-por", "x-por-y", "leve-x-pague-y", "por-unidade", "acima-de"
  label       String
  configSchema Json?                 // descreve os campos que a dinâmica exige
  active      Boolean @default(true)
  offers      Offer[]
}

// Oferta "de catálogo" (reutilizável). Ao entrar num tabloide vira TabloidOffer (snapshot).
model Offer {
  id           String    @id @default(cuid())
  productId    String?
  product      Product?  @relation(fields: [productId], references: [id])
  typeId       String    @default("simple")
  type         OfferType @relation(fields: [typeId], references: [id])

  title        String?   // descrição comercial exibida (pode diferir do nome do produto)
  imageUrl     String?
  price        Decimal?  @db.Decimal(12, 2)
  previousPrice Decimal? @db.Decimal(12, 2)
  unit         String?
  quantity     Int?
  dynamicData  Json?     // parâmetros específicos da dinâmica (ex.: leve=3, pague=2)
  validFrom    DateTime?
  validTo      DateTime?
  category     String?
  priority     Int       @default(0) // destaque comercial (usado na autodiagramação)
  metadata     Json?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([category])
}

// ───────────────────────────── Templates ─────────────────────────────────────

model Template {
  id          String  @id @default(cuid())
  name        String
  description String?
  formatId    String                       // A4, A5, digital-1080x1350...
  format      PageFormat @relation(fields: [formatId], references: [id])
  thumbnailUrl String?
  // Tema visual do template (cores/tipografia). Nas artes reais varia por campanha:
  // vermelho (açougue), verde (hortifrúti/mercearia), festivo (R$10). Ver docs/ANALISE-VISUAL.md.
  theme       Json?
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pages       TemplatePage[]
  tabloids    Tabloid[]
}

model PageFormat {
  id          String @id                    // "a4", "a5", "digital-1080x1350"
  label       String
  widthMm     Float
  heightMm    Float
  orientation Orientation @default(PORTRAIT)
  templates   Template[]
  tabloids    Tabloid[]
}

enum Orientation {
  PORTRAIT
  LANDSCAPE
}

model TemplatePage {
  id         String   @id @default(cuid())
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)
  background Json?    // cor/imagem/gradiente
  grid       Json?    // colunas, linhas, gutter, margens, área segura
  elements   Json     @default("[]") // scene graph estático (textos, formas, imagens)
  frames     OfferFrame[]
}

// Posições vazias no template onde ofertas podem entrar (NÃO são ofertas).
model OfferFrame {
  id             String       @id @default(cuid())
  templatePageId String
  templatePage   TemplatePage @relation(fields: [templatePageId], references: [id], onDelete: Cascade)
  x              Float
  y              Float
  w              Float
  h              Float
  rotation       Float        @default(0)
  z              Int          @default(0)
  frameStyleId   String?
  frameStyle     FrameStyle?  @relation(fields: [frameStyleId], references: [id])
  weight         Int          @default(1) // "importância" da posição p/ o scoring
  // Nas artes reais os frames vivem em "faixas" por categoria (Açougue/Frios, Hortifrúti,
  // Pescado, Bebidas, Mercearia...) com rótulo lateral. groupLabel identifica a faixa.
  groupLabel     String?
}

// Estilo visual reutilizável do frame (mapeia campos da oferta -> subelementos).
model FrameStyle {
  id        String @id @default(cuid())
  name      String
  config    Json   // slots: imagem, descrição, preço(por dinâmica), selos, validade...
  frames    OfferFrame[]
  elements  TabloidElement[]
}

// ───────────────────────────── Tabloide (documento) ──────────────────────────

model Tabloid {
  id          String        @id @default(cuid())
  name        String
  status      TabloidStatus @default(DRAFT)
  formatId    String
  format      PageFormat    @relation(fields: [formatId], references: [id])
  templateId  String?
  template    Template?     @relation(fields: [templateId], references: [id])
  ownerId     String?
  owner       User?         @relation("TabloidOwner", fields: [ownerId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  pages       TabloidPage[]
  offers      TabloidOffer[]
  versions    TabloidVersion[]
  reviews     Review[]
  exports     Export[]
  layoutRuns  LayoutRun[]

  @@index([status])
}

enum TabloidStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ARCHIVED
}

model TabloidPage {
  id         String   @id @default(cuid())
  tabloidId  String
  tabloid    Tabloid  @relation(fields: [tabloidId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)
  background Json?
  grid       Json?
  elements   Json     @default("[]") // scene graph desta página (inclui offer-frames)

  @@unique([tabloidId, sortOrder])
}

// Oferta congelada no contexto do tabloide (snapshot editável, versionável).
model TabloidOffer {
  id            String   @id @default(cuid())
  tabloidId     String
  tabloid       Tabloid  @relation(fields: [tabloidId], references: [id], onDelete: Cascade)
  sourceOfferId String?  // origem (Offer) se veio do catálogo
  sourceProductId String? // origem (Product) p/ rastrear uso

  typeId        String   @default("simple")
  title         String?
  imageUrl      String?
  price         Decimal? @db.Decimal(12, 2)
  previousPrice Decimal? @db.Decimal(12, 2)
  unit          String?
  quantity      Int?
  dynamicData   Json?
  validFrom     DateTime?
  validTo       DateTime?
  category      String?
  priority      Int      @default(0)
  metadata      Json?

  @@index([tabloidId])
  @@index([sourceProductId])
}

// Snapshot imutável do documento inteiro para versionamento/revisão (seções 20–21).
model TabloidVersion {
  id         String   @id @default(cuid())
  tabloidId  String
  tabloid    Tabloid  @relation(fields: [tabloidId], references: [id], onDelete: Cascade)
  label      String?  // "Versão 1", "Versão final"
  snapshot   Json     // documento completo (páginas + offers) congelado
  createdById String?
  createdAt  DateTime @default(now())
  reviews    Review[]

  @@index([tabloidId])
}

// Placeholder de referência: elementos podem ser espelhados relacionalmente quando
// precisarmos consultar por tipo/estilo (o scene graph fica em TabloidPage.elements).
model TabloidElement {
  id           String      @id @default(cuid())
  frameStyleId String?
  frameStyle   FrameStyle? @relation(fields: [frameStyleId], references: [id])
  // Reservado para Fase 2, caso o espelhamento relacional se mostre necessário.
}

// ───────────────────────────── Revisão ───────────────────────────────────────

model Review {
  id            String   @id @default(cuid())
  tabloidId     String
  tabloid       Tabloid  @relation(fields: [tabloidId], references: [id], onDelete: Cascade)
  versionId     String?
  version       TabloidVersion? @relation(fields: [versionId], references: [id])
  status        ReviewStatus @default(OPEN)
  createdAt     DateTime @default(now())
  participants  ReviewParticipant[]
  actions       ReviewAction[]
}

enum ReviewStatus {
  OPEN
  APPROVED
  REJECTED
  STALE   // documento alterado após a revisão
}

model ReviewParticipant {
  id         String   @id @default(cuid())
  reviewId   String
  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  viewedAt   DateTime?
  reviewedAt DateTime?
  status     ParticipantStatus @default(PENDING)

  @@unique([reviewId, userId])
}

enum ParticipantStatus {
  PENDING
  VIEWED
  REVIEWED
  APPROVED
}

model ReviewAction {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String?
  kind      String   // "view", "reviewed", "approve", "comment"
  payload   Json?    // comentário, página, coordenada...
  createdAt DateTime @default(now())
}

// ───────────────────────────── Exportação ────────────────────────────────────

model Export {
  id        String   @id @default(cuid())
  tabloidId String
  tabloid   Tabloid  @relation(fields: [tabloidId], references: [id], onDelete: Cascade)
  format    String   // "pdf" | "png"
  url       String?
  status    String   @default("done")
  createdAt DateTime @default(now())
}

// ───────────────────────────── Aprendizado (coleta) ──────────────────────────

// Registro de cada autodiagramação + diffs manuais (alimenta a Fase 3; sem ML no MVP).
model LayoutRun {
  id           String   @id @default(cuid())
  tabloidId    String
  tabloid      Tabloid  @relation(fields: [tabloidId], references: [id], onDelete: Cascade)
  templateId   String?
  input        Json     // ofertas + frames considerados
  result       Json     // atribuição oferta->frame gerada
  manualDiff   Json?    // o que o usuário alterou depois (mover/resize/trocar)
  weights      Json?    // pesos do scoring usados
  createdAt    DateTime @default(now())
}
