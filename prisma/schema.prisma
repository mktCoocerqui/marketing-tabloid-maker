// Modelo de dados — Plataforma de tabloides
// Hierarquia PIM (a pedido): ProductBase (família) → Sku (apresentação/variação) → Offer → TabloidOffer → frame.
// COD_ERP é o identificador externo estável do SKU. Dados de ERP ficam à parte (erpData).
// Ver docs/MODELO-DE-DADOS.md, docs/PIM.md e docs/ANALISE-EXCEL.md.

generator client {
  provider = "prisma-client-js"
  // "native" p/ dev; "rhel-openssl-3.0.x" é o runtime serverless da Vercel (Amazon Linux).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────── Usuários & acesso ─────────────────────────────

model User {
  id        String   @id // = auth.users.id (Supabase Auth)
  email     String   @unique
  name      String?
  role      UserRole @default(EDITOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdTabloids      Tabloid[]           @relation("TabloidOwner")
  reviewParticipations ReviewParticipant[]
}

enum UserRole {
  ADMIN
  EDITOR
  REVIEWER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

// ───────────────────────── PIM: Produto base (família) ───────────────────────
// UI: "Produto". Conceito comercial principal (ex.: "Carne Bovina Acém").
// NÃO possui preço — preço vive no SKU/Oferta.

model ProductBase {
  id           String        @id @default(cuid())
  name         String
  category     String?
  subcategory  String?
  description  String?
  brand        String?
  status       ProductStatus @default(ACTIVE)
  mainImageUrl String?       // imagem genérica/base (fallback)
  metadata     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  skus Sku[]

  @@index([category])
  @@index([name])
}

// ─────────────────────────── SKU / Apresentação ──────────────────────────────
// UI: "Apresentação". Ex.: "Acém KG", "Acém Bandeja". Identificado por COD_ERP.

model Sku {
  id            String        @id @default(cuid())
  productBaseId String?
  productBase   ProductBase?  @relation(fields: [productBaseId], references: [id])
  erpCode       String?       @unique // COD_ERP — referência externa estável
  barcode       String?
  name          String                // nome comercial (DESCRICAO)
  description   String?
  unit          String?               // KG, UN, CX...
  weight        Float?
  imageUrl      String?
  altImageUrl   String?
  regularPrice  Decimal?      @db.Decimal(12, 2) // PRECO (regular)
  status        ProductStatus @default(ACTIVE)
  // Dados do ERP guardados separadamente (não confundir COD_FAMILIA com produto base):
  // { codFamilia, curva, comprador, parametroFamilia, custo, volumeMedio, ... }
  erpData       Json?
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  offers Offer[]

  @@index([productBaseId])
  @@index([barcode])
  @@index([name])
}

// ───────────────────────────── Ofertas & dinâmicas ───────────────────────────

// Registro de dinâmicas comerciais (registry no código; tabela p/ metadados/UI).
model OfferType {
  id           String  @id // "simple","de-por","cooperado","x-por-y","leve-x-por-y","leve-x-pague-y","por-unidade","acima-de","combo"
  label        String
  configSchema Json?
  active       Boolean @default(true)
  offers       Offer[]
}

// Oferta reutilizável: um SKU + condição comercial em um período. Um mesmo SKU
// pode ter várias ofertas ao longo do tempo (é o mesmo produto, ofertas diferentes).
model Offer {
  id            String    @id @default(cuid())
  skuId         String
  sku           Sku       @relation(fields: [skuId], references: [id], onDelete: Cascade)
  typeId        String    @default("simple")
  type          OfferType @relation(fields: [typeId], references: [id])

  title         String?   // descrição exibida (override do nome do SKU)
  imageUrl      String?   // override da imagem do SKU
  price         Decimal?  @db.Decimal(12, 2) // preço promocional (Dirigida)
  previousPrice Decimal?  @db.Decimal(12, 2) // "De" (Padrão)
  regularPrice  Decimal?  @db.Decimal(12, 2) // opcional; herda do SKU se ausente
  unit          String?
  quantity      Int?
  dynamicData   Json?     // parâmetros da dinâmica (leve/pague, x-por-y, cooperado, limite...)
  validFrom     DateTime?
  validTo       DateTime?
  campaign      String?   // CAMPANHA (aba de origem no Excel)
  priority      Int       @default(0)
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([skuId])
}

// ───────────────────────────── Templates ─────────────────────────────────────

model Template {
  id           String     @id @default(cuid())
  name         String
  description  String?
  formatId     String
  format       PageFormat @relation(fields: [formatId], references: [id])
  thumbnailUrl String?
  theme        Json? // tema visual (cores/tipografia) — varia por campanha
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  pages    TemplatePage[]
  tabloids Tabloid[]
}

model PageFormat {
  id          String      @id
  label       String
  widthMm     Float
  heightMm    Float
  orientation Orientation @default(PORTRAIT)
  templates   Template[]
  tabloids    Tabloid[]
}

enum Orientation {
  PORTRAIT
  LANDSCAPE
}

model TemplatePage {
  id         String       @id @default(cuid())
  templateId String
  template   Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sortOrder  Int          @default(0)
  background Json?
  grid       Json?
  elements   Json         @default("[]")
  frames     OfferFrame[]
}

// Posições vazias no template onde ofertas podem entrar (NÃO são ofertas).
model OfferFrame {
  id             String       @id @default(cuid())
  templatePageId String
  templatePage   TemplatePage @relation(fields: [templatePageId], references: [id], onDelete: Cascade)
  x              Float
  y              Float
  w              Float
  h              Float
  rotation       Float        @default(0)
  z              Int          @default(0)
  frameStyleId   String?
  frameStyle     FrameStyle?  @relation(fields: [frameStyleId], references: [id])
  weight         Int          @default(1)
  groupLabel     String?      // faixa/categoria (Açougue, Hortifrúti...)
}

// Estilo visual reutilizável do frame (mapeia campos da oferta -> subelementos).
model FrameStyle {
  id       String           @id @default(cuid())
  name     String
  config   Json
  frames   OfferFrame[]
  elements TabloidElement[]
}

// ───────────────────────────── Tabloide (documento) ──────────────────────────

model Tabloid {
  id         String        @id @default(cuid())
  name       String
  status     TabloidStatus @default(DRAFT)
  formatId   String
  format     PageFormat    @relation(fields: [formatId], references: [id])
  templateId String?
  template   Template?     @relation(fields: [templateId], references: [id])
  ownerId    String?
  owner      User?         @relation("TabloidOwner", fields: [ownerId], references: [id])
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  pages      TabloidPage[]
  offers     TabloidOffer[]
  versions   TabloidVersion[]
  reviews    Review[]
  exports    Export[]
  layoutRuns LayoutRun[]

  @@index([status])
}

enum TabloidStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ARCHIVED
}

model TabloidPage {
  id         String  @id @default(cuid())
  tabloidId  String
  tabloid    Tabloid @relation(fields: [tabloidId], references: [id], onDelete: Cascade)
  sortOrder  Int     @default(0)
  background Json?
  grid       Json?
  elements   Json    @default("[]") // scene graph (inclui offer-frames)

  @@unique([tabloidId, sortOrder])
}

// Oferta congelada no contexto do tabloide (snapshot editável). Referencia o SKU
// por id (não copia o produto inteiro) e a oferta de origem quando houver.
model TabloidOffer {
  id            String    @id @default(cuid())
  tabloidId     String
  tabloid       Tabloid   @relation(fields: [tabloidId], references: [id], onDelete: Cascade)
  skuId         String?   // referência ao SKU
  sourceOfferId String?   // origem (Offer) se veio de uma oferta salva

  typeId        String    @default("simple")
  title         String?
  imageUrl      String?
  price         Decimal?  @db.Decimal(12, 2)
  previousPrice Decimal?  @db.Decimal(12, 2)
  regularPrice  Decimal?  @db.Decimal(12, 2)
  unit          String?
  quantity      Int?
  dynamicData   Json?
  validFrom     DateTime?
  validTo       DateTime?
  priority      Int       @default(0)
  metadata      Json?

  @@index([tabloidId])
  @@index([skuId])
}

// Snapshot imutável do documento inteiro para versionamento/revisão.
model TabloidVersion {
  id          String   @id @default(cuid())
  tabloidId   String
  tabloid     Tabloid  @relation(fields: [tabloidId], references: [id], onDelete: Cascade)
  label       String?
  snapshot    Json
  createdById String?
  createdAt   DateTime @default(now())
  reviews     Review[]

  @@index([tabloidId])
}

// Reservado (Fase 2) para espelhamento relacional de elementos, se necessário.
model TabloidElement {
  id           String      @id @default(cuid())
  frameStyleId String?
  frameStyle   FrameStyle? @relation(fields: [frameStyleId], references: [id])
}

// ───────────────────────────── Revisão ───────────────────────────────────────

model Review {
  id           String          @id @default(cuid())
  tabloidId    String
  tabloid      Tabloid         @relation(fields: [tabloidId], references: [id], onDelete: Cascade)
  versionId    String?
  version      TabloidVersion? @relation(fields: [versionId], references: [id])
  status       ReviewStatus    @default(OPEN)
  createdAt    DateTime        @default(now())
  participants ReviewParticipant[]
  actions      ReviewAction[]
}

enum ReviewStatus {
  OPEN
  APPROVED
  REJECTED
  STALE
}

model ReviewParticipant {
  id         String            @id @default(cuid())
  reviewId   String
  review     Review            @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId     String
  user       User              @relation(fields: [userId], references: [id])
  viewedAt   DateTime?
  reviewedAt DateTime?
  status     ParticipantStatus @default(PENDING)

  @@unique([reviewId, userId])
}

enum ParticipantStatus {
  PENDING
  VIEWED
  REVIEWED
  APPROVED
}

model ReviewAction {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String?
  kind      String
  payload   Json?
  createdAt DateTime @default(now())
}

// ───────────────────────────── Exportação ────────────────────────────────────

model Export {
  id        String   @id @default(cuid())
  tabloidId String
  tabloid   Tabloid  @relation(fields: [tabloidId], references: [id], onDelete: Cascade)
  format    String
  url       String?
  status    String   @default("done")
  createdAt DateTime @default(now())
}

// ───────────────────────────── Aprendizado (coleta) ──────────────────────────

model LayoutRun {
  id         String   @id @default(cuid())
  tabloidId  String
  tabloid    Tabloid  @relation(fields: [tabloidId], references: [id], onDelete: Cascade)
  templateId String?
  input      Json
  result     Json
  manualDiff Json?
  weights    Json?
  createdAt  DateTime @default(now())
}
