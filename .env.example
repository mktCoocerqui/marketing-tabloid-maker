# ── Supabase Postgres (Prisma) ──
# Supabase → Project Settings → Database → Connection string.
# DATABASE_URL = Transaction pooler (porta 6543, sufixo ?pgbouncer=true) — usado pelo app.
# DIRECT_URL   = conexão direta (porta 5432) — usado por migrations.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-us-west-2.pooler.supabase.com:5432/postgres"

# ── Supabase Auth + Storage (chaves do projeto) ──
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."   # chave pública (browser)
SUPABASE_SECRET_KEY="sb_secret_..."                          # SOMENTE servidor (service role)

# ── App ──
AUTH_SECRET="troque-por-um-segredo-aleatorio"
