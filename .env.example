# ── Banco (Postgres gerenciado; serverless-safe na Vercel) ──
# DATABASE_URL = conexão POOLED (PgBouncer). DIRECT_URL = conexão direta p/ migrations.
# Em dev local, ambas podem apontar para o mesmo Postgres.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tabloids?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/tabloids?schema=public"

# ── Auth (Auth.js) — fatia 2 ──
AUTH_SECRET="troque-por-um-segredo-aleatorio"

# ── Storage de imagens ──
# Produção (Vercel): Vercel Blob. Dev: disco local (fallback automático).
BLOB_READ_WRITE_TOKEN=""

# ── Exportação PNG/PDF (fatia 4) ──
# Na Vercel usa @sparticuz/chromium (sem download). Em dev pode usar o Chromium local:
# PLAYWRIGHT_BROWSERS_PATH="/opt/pw-browsers"
